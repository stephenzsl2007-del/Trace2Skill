{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace2skill.local/schemas/fixture-v0.3.schema.json",
  "title": "Trace2Skill immutable fixture v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "fixture_id", "split", "package_manager", "failure_class",
    "expected_failure_stage", "initial_snapshot_hash", "commands", "error_patterns", "safety"
  ],
  "properties": {
    "schema_version": {"const": "0.3"},
    "fixture_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["training", "held-out"]},
    "package_manager": {"enum": ["npm", "pnpm"]},
    "failure_class": {"type": "string", "minLength": 1},
    "expected_failure_stage": {"enum": ["install", "build"]},
    "initial_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reproduce", "install", "build", "test"],
      "properties": {
        "reproduce": {"$ref": "#/$defs/command"},
        "install": {"$ref": "#/$defs/command"},
        "build": {"$ref": "#/$defs/command"},
        "test": {"$ref": "#/$defs/command"}
      }
    },
    "error_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_files", "allowed_package_fields", "network", "lifecycle_scripts"],
      "properties": {
        "allowed_files": {"type": "array", "items": {"type": "string"}},
        "allowed_package_fields": {"type": "array", "items": {"type": "string"}},
        "network": {"const": false},
        "lifecycle_scripts": {"const": false}
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
