{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace2skill.dev/schemas/day4-trial-0.2.0.json",
  "title": "Trace2Skill Day 4 AgentTeams Trial",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "fixture_id", "split", "condition", "framework", "prompt_sha256", "skill_sha256", "events", "metrics", "validation", "result", "security"],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "trace_id": { "type": "string", "pattern": "^agentteams:" },
    "fixture_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["training", "held-out"] },
    "condition": { "enum": ["baseline", "skill-assisted"] },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "manager_model", "worker_model", "worker_name"],
      "properties": {
        "name": { "const": "AgentTeams" },
        "version": { "type": "string", "minLength": 1 },
        "manager_model": { "type": "string", "minLength": 1 },
        "worker_model": { "type": "string", "minLength": 1 },
        "worker_name": { "type": "string", "minLength": 1 }
      }
    },
    "prompt_sha256": { "$ref": "#/$defs/sha256" },
    "skill_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "timestamp_ms", "sender_role", "body_sha256", "event_id_hash", "room_id_hash"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "timestamp_ms": { "type": "integer", "minimum": 0 },
          "sender_role": { "enum": ["manager", "worker", "admin"] },
          "body_sha256": { "$ref": "#/$defs/sha256" },
          "event_id_hash": { "$ref": "#/$defs/sha256" },
          "room_id_hash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "tool_calls", "tool_errors", "duration_ms", "input_tokens", "output_tokens", "token_cost_usd", "token_measurement"],
      "properties": {
        "event_count": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "tool_errors": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "token_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "token_measurement": { "enum": ["available", "unavailable"] }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_failure_reproduced", "verification_passed", "verification_exit_code", "verification_duration_ms", "proposed_package_json_sha256", "verification_output_sha256"],
      "properties": {
        "original_failure_reproduced": { "type": "boolean" },
        "verification_passed": { "type": "boolean" },
        "verification_exit_code": { "type": "integer" },
        "verification_duration_ms": { "type": "integer", "minimum": 0 },
        "proposed_package_json_sha256": { "$ref": "#/$defs/sha256" },
        "verification_output_sha256": { "$ref": "#/$defs/sha256" },
        "proposal_rejection": {
          "enum": ["protected-metadata-or-no-dependency-change", "unsafe-dependency-spec", "result-identity-mismatch", "agentteams-timeout", "invalid-worker-result"]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_result_sha256", "status"],
      "properties": {
        "worker_result_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["success", "failed"] }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["held_out_answer_in_prompt", "raw_messages_persisted", "network_used_by_validator", "secret_scan_passed"],
      "properties": {
        "held_out_answer_in_prompt": { "const": false },
        "raw_messages_persisted": { "const": false },
        "network_used_by_validator": { "const": false },
        "secret_scan_passed": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
