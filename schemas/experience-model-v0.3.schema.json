{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace2skill.local/schemas/experience-model-v0.3.schema.json",
  "title": "Trace2Skill Experience Model v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experience_id", "trace_ids", "scope", "task_signatures",
    "package_manager_detection", "success_paths", "failed_attempts", "preconditions",
    "tools_permissions", "prohibited_actions", "validator_rules", "conclusions"
  ],
  "properties": {
    "schema_version": {"const": "0.3"},
    "experience_id": {"type": "string", "minLength": 1},
    "trace_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "ecosystems", "failure_classes", "exclusions"],
      "properties": {
        "domain": {"const": "javascript-typescript-ci-dependencies"},
        "ecosystems": {"type": "array", "items": {"enum": ["npm", "pnpm"]}, "uniqueItems": true},
        "failure_classes": {"type": "array", "items": {"type": "string"}},
        "exclusions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "task_signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenced"}},
    "package_manager_detection": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenced"}},
    "success_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenced"}},
    "failed_attempts": {"type": "array", "items": {"$ref": "#/$defs/evidenced"}},
    "preconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenced"}},
    "tools_permissions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenced"}},
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenced"}},
    "validator_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenced"}},
    "conclusions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/conclusion"}}
  },
  "$defs": {
    "evidenceRef": {"type": "string", "pattern": "^trace:[^#]+#[^#]+$"},
    "evidenced": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceRef"}}
      }
    },
    "conclusion": {
      "allOf": [
        {"$ref": "#/$defs/evidenced"},
        {
          "type": "object",
          "required": ["confidence", "limitations", "conflicts"],
          "properties": {
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "limitations": {"type": "array", "items": {"type": "string"}},
            "conflicts": {"type": "array", "items": {"type": "string"}}
          }
        }
      ]
    }
  }
}
